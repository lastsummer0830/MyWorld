{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "disableAllHooks": true,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  },
  "skillOverrides": {
    "algorithmic-art": "off",
    "assignment-quality-review": "off",
    "canvas-design": "off",
    "git-workflow-guard": "off",
    "image-prompt-crafter": "off",
    "knowva-design-guard": "off",
    "portfolio-readme-upgrader": "off",
    "resume-polisher": "off",
    "theme-factory": "off",
    "web-artifacts-builder": "off"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)"
    ],
    "deny": [
      "mcp__*",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/.git/**)",
      "Read(/node_modules/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.git/**)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx * install *)"
    ]
  }
}
